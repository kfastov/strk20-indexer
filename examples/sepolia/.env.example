# Copy to .env (gitignored at the repo root) and fill in. PLACEHOLDERS ONLY —
# never commit a filled-in copy, and never put a mainnet key in any of these.
#
#   cp .env.example .env && $EDITOR .env
#   set -a; . ./.env; set +a
#
# TESTNET ONLY. Every run script aborts unless starknet_chainId == SN_SEPOLIA.

# ── Secrets: pick ONE of the two shapes ───────────────────────────────────────

# (a) An sncast accounts file you already have. It holds private keys, so keep it
#     outside this repository, mode 0600.
#       sncast --accounts-file "$STRK20_ACCOUNTS_FILE" account create -n strk20test --url "$STRK20_RPC"
STRK20_ACCOUNTS_FILE=/absolute/path/outside/this/repo/accounts.json
STRK20_ACCOUNTS_NETWORK=alpha-sepolia
STRK20_ACCOUNT=strk20test

# (b) Or the account directly in the environment. If STRK20_ACCOUNT_PRIVATE_KEY
#     is set it wins over the accounts file.
#STRK20_ACCOUNT_ADDRESS=0xREPLACE_WITH_YOUR_SEPOLIA_ACCOUNT_ADDRESS
#STRK20_ACCOUNT_PRIVATE_KEY=0xREPLACE_WITH_YOUR_TESTNET_PRIVATE_KEY
#STRK20_ACCOUNT_PUBLIC_KEY=0xREPLACE_WITH_YOUR_ACCOUNT_PUBLIC_KEY

# Where the derived pool viewing key and the transaction record are persisted.
# Written mode 0600. MUST be outside this repository. "{account}" is substituted.
STRK20_KEY_FILE=/absolute/path/outside/this/repo/viewing-key-{account}.json

# ── Non-secret settings (defaults shown; override only if you need to) ────────

# Working artifacts: call-and-proof dumps. No key material is written here.
#STRK20_OUT_DIR=./.local

#STRK20_RPC=https://starknet-sepolia-rpc.publicnode.com
#STRK20_POOL=0x0254a6b2997ef52e9f830ce1f543f6b29768295e8d17e2267d672c552cfe0d91
#STRK20_STRK_TOKEN=0x04718f5a0fc34cc1af16a1cdee98ffb20c31f5cd61d6ab07201858f4287c938d
#STRK20_PROVER_URL=https://transaction-prover.alpha-sepolia.sw-dev.io
#STRK20_DISCOVERY_URL=https://discovery-service.alpha-sepolia.sw-dev.io

# The sequencer rejects proofs whose base block is too recent (observed cutoff
# head-7). Upstream uses head-9. Do not lower this.
#STRK20_PROVING_BLOCK_DEPTH=9

# Per-run knobs
#DEPOSIT_STRK=3
#SHAPE=transfer      # spend.mjs: transfer | withdraw
#DRY_RUN=1           # estimate everything, submit nothing
