# STRK20 mainnet lifecycle — configuration.
#
# Copy to .env and edit.  `.env` is gitignored and is read ONLY by you:
#   set -a; . ./.env; set +a
# The scripts read plain environment variables; they never open `.env`
# themselves and never read anything from the repo's `data/` directory.
#
# PLACEHOLDERS ONLY BELOW — never commit a real key.

# ─── where key material is written and read ──────────────────────────────────
# A directory, OUTSIDE this repository by default.  `examples/` is a tracked
# tree; a real private key must never land in it.  01-create-account.mjs
# creates the directory (mode 0700) and writes:
#   account.json     account address + private key + viewing key  (mode 0600)
#   viewing-key.hex  the viewing key alone, for `strk20-sync --key-file`
#   state.json       which lifecycle steps have completed (for idempotency)
# A leading ~ is expanded.  Default: ~/.strk20/mainnet-keystore
STRK20_KEYSTORE=~/.strk20/mainnet-keystore

# ─── chain ───────────────────────────────────────────────────────────────────
# Must serve JSON-RPC spec >= 0.10 — v3 proof-carrying transactions need it.
# Verified 2026-08-31: publicnode serves 0.10.2 on mainnet.
# (https://rpc.starknet.lava.build serves 0.8.1 and will NOT work for writes.)
STRK20_RPC=https://starknet.publicnode.com

# The scripts refuse to run unless starknet_chainId == SN_MAIN.
STRK20_POOL=0x040337b1af3c663e86e333bab5a4b28da8d4652a15a69beee2b677776ffe812a

# STRK fee token — same address on every Starknet network, hardcoded in the
# pool's Cairo (packages/privacy/src/utils.cairo).
STRK20_STRK=0x04718f5a0fc34cc1af16a1cdee98ffb20c31f5cd61d6ab07201858f4287c938d

# OpenZeppelin account v1.0.0 — verified declared on mainnet 2026-08-31.
STRK20_ACCOUNT_CLASS=0x05b4b537eaa2399e3aa99c4e2e0208ebd6c71bc1467938cd52c798c601e43564

# ─── privacy services ────────────────────────────────────────────────────────
STRK20_PROVER=https://transaction-prover.alpha-mainnet.sw-dev.io
STRK20_DISCOVERY=https://discovery-service.alpha-mainnet.sw-dev.io

# ─── amounts (decimal STRK, not wei) ─────────────────────────────────────────
# 03-shield.mjs: how much to move into the pool.  Must be > 0.  The 6 STRK pool
# fee is charged SEPARATELY from your public balance, so the shielded note ends
# up worth exactly this much.
STRK20_DEPOSIT_STRK=2

# 04-transfer.mjs: private note-to-note transfer.  Leave the recipient blank to
# transfer to your own address (cheapest way to exercise a spend).
STRK20_TRANSFER_STRK=2
STRK20_TRANSFER_TO=

# 05-withdraw.mjs: move shielded value back to a public address.  Blank
# recipient = your own account.  Blank amount = withdraw the whole note.
STRK20_WITHDRAW_STRK=
STRK20_WITHDRAW_TO=

# ─── 06-discover.sh ──────────────────────────────────────────────────────────
# The feed your indexer publishes: an http(s) /feed endpoint or a local mirror
# directory produced by `strk20 backfill`.
STRK20_FEED=https://example.invalid/feed
STRK20_SYNC_DB=~/.strk20/mainnet-keystore/sync.db

# ─── safety / tuning ─────────────────────────────────────────────────────────
# 1 = build, prove and estimate, print the fee breakdown, then STOP without
# submitting.  Always do a dry run first.
DRY_RUN=1

# Resource-bounds headroom over the node's estimate, in percent.  The scripts
# submit with the estimate's own bounds by default (0).  Raise it if a
# transaction reverts for gas; lower it only if your balance is marginal and
# you understand that too little means the transaction runs out of gas.
STRK20_FEE_MARGIN_PERCENT=0

# Set to 1 to re-run a lifecycle step that state.json records as already done.
FORCE=0
