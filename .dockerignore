# Build context = the sources cargo needs, and nothing else.
#
# `target/`, `data/`, `vendor/` and `ts/` are the four that matter. `data/`
# alone is ~600 MB of live mainnet + Sepolia feed and databases, and shipping
# any of them into the context would make every build upload them to the
# daemon.
#
# `vendor/` is a cloned starknet-privacy checkout plus the compiled SDK and
# its node_modules, ~500 MB. Nothing under it is a cargo workspace member, so
# the build never needs it.

target/
data/
vendor/
.git/
.gitignore
.env
*.log

# The TypeScript workspace is not a Cargo workspace member and no Rust source
# references paths under it. Its dependencies and build output are not needed
# by `cargo build -p strk20-indexerd`.
ts/

# Docs and notes are not compiled.
docs/
README.md
LICENSE

# Not excluded, on purpose:
#   Cargo.lock  — the build runs `--locked` against it
#   crates/     — every workspace member's manifest must exist for `-p` to
#                 resolve the workspace, even though only `strk20-indexerd`
#                 is compiled
#   fixtures/   — only referenced from `#[cfg(test)]` code, so the release
#                 build never opens it, but at 44 KB it is cheaper to keep
#                 than to have `cargo test` inside the image fail to compile

# Anything docker-related is read by the daemon, not copied into the image.
Dockerfile
.dockerignore
docker-compose.yml
