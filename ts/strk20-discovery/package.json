{
  "name": "strk20-discovery",
  "version": "0.0.0-dev.0",
  "type": "module",
  "description": "Keyless STRK20 note discovery. The viewing key stays in the browser; every client fetches identical public bytes.",
  "license": "Apache-2.0",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./sdk": "./dist/index.js",
    "./worker": "./dist/worker.js",
    "./scan": "./dist/scan.js",
    "./node": "./dist/node.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/copy-wasm.mjs --clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "node scripts/copy-wasm.mjs --clean && tsc -p tsconfig.build.json",
    "test": "node --test --experimental-strip-types \"test/**/*.test.ts\"",
    "scan:chokepoint": "node scripts/scan-chokepoint.mjs"
  },
  "dependencies": {
    "@starkware-libs/starknet-privacy-sdk": "file:../../examples/mainnet/vendor/starknet-privacy-sdk",
    "fzstd": "0.1.1",
    "starknet": "10.5.0"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "typescript": "5.9.2",
    "@types/node": "^24.0.0"
  },
  "peerDependencies": {
    "typescript": ">=5.6"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  }
}
