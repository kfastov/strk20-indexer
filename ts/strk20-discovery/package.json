{
  "name": "strk20-discovery",
  "version": "0.0.0-dev.0",
  "type": "module",
  "description": "Keyless STRK20 note discovery. The viewing key stays in the browser; every client fetches identical public bytes.",
  "license": "Apache-2.0",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./sdk": "./dist/sdk.js",
    "./delegated": "./dist/delegated.js",
    "./engine/mock": "./dist/engine-mock.js",
    "./engine/wasm": "./dist/engine-wasm.js",
    "./scan": "./dist/scan.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "node -e \"const n=require('node:fs').readdirSync('test',{recursive:true}).filter(f=>String(f).endsWith('.test.ts')).length;if(!n){console.error('no test files under test/ \u2014 an empty suite must not report green');process.exit(1)}\"",
    "test": "node --test --experimental-strip-types \"test/**/*.test.ts\"",
    "scan:chokepoint": "node scripts/scan-chokepoint.mjs"
  },
  "dependencies": {
    "fzstd": "0.1.1"
  },
  "devDependencies": {
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "typescript": ">=5.6"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
